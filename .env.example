# Public site URL for SEO (canonical, Open Graph, sitemap)
SITE_URL=https://www.felix-schultz.net

# Google Tag Manager (optional) — container ID from tagmanager.google.com
# Set in Vercel for production; omit locally to disable tracking.
VITE_GTM_ID=GTM-TZ2NGWRZ

# Used by the portfolio site (loaders)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-05-16
# Site loader token (Viewer is enough for published content)
SANITY_API_TOKEN=

# Studio only — Editor or Administrator (create/upload assets). Separate from SANITY_API_TOKEN.
# Exposed to the browser when you run npm run studio. Do not use Access Manager or Viewer.
SANITY_STUDIO_API_TOKEN=

# Optional: override studio-only vars (defaults mirror SANITY_* above)
# SANITY_STUDIO_PROJECT_ID=your_project_id
# SANITY_STUDIO_DATASET=production
# SANITY_STUDIO_SITE_URL=https://www.felix-schultz.net
# Local dev (also used by `npm run dev:shop-link` and Studio `npm run studio`):
# SITE_URL=http://localhost:5173
# SANITY_STUDIO_SITE_URL=http://localhost:5173

# Production Studio (https://studio.felix-schultz.net) — set in Vercel project root: studio/
# After first Vercel deploy, run: npm run studio:register

# Private shop (Stripe) — site project on Vercel
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# PURCHASE_JWT_SECRET=long_random_string_at_least_32_chars
# DELIVERY_CONTACT_EMAIL=you@example.com

# Optional: Stripe webhook (dashboard → Developers → Webhooks → /api/stripe/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
