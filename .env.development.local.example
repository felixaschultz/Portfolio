# Copy to .env.local (or merge) for local site + shop testing.
# Vite / react-router dev loads .env.local automatically.

SITE_URL=http://localhost:5173
SANITY_STUDIO_SITE_URL=http://localhost:5173

# From Stripe Dashboard → Developers → API keys (test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# openssl rand -hex 32
# PURCHASE_JWT_SECRET=

# Resend — automatic download-link email after purchase (https://resend.com)
# RESEND_API_KEY=re_...
# Until your domain is verified in Resend, send from their sandbox:
# SHOP_EMAIL_FROM=Felix A. Schultz <onboarding@resend.dev>
# Production (after DNS verification):
# SHOP_EMAIL_FROM=Felix A. Schultz <photos@felix-schultz.net>

# Editor token from sanity.io/manage (for dev:shop-link script + draft downloads)
# SANITY_STUDIO_API_TOKEN=
